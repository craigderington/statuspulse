<div style="font-family: -apple-system, Segoe UI, Roboto, sans-serif; background: #07090c; color: #e8ecf2; padding: 28px;">
  <div style="max-width: 560px; margin: 0 auto; border: 1px solid rgba(232,236,242,0.13); border-radius: 3px; background: #0b0e13;">

    <div style="padding: 18px 22px; border-bottom: 1px solid rgba(232,236,242,0.13);">
      <span style="display: inline-block; font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #e5484d; border: 1px solid #e5484d; border-radius: 2px; padding: 3px 8px;">Down</span>
      <span style="font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #5b6472; margin-left: 10px;"><%= @organization.name %></span>
    </div>

    <div style="padding: 24px 22px;">
      <h1 style="margin: 0 0 8px; font-size: 21px; line-height: 1.2;"><%= @service.name %> is down</h1>
      <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; color: #8f98a6;">
        <%= Service::ALERT_AFTER_CONSECUTIVE_FAILURES %> consecutive checks have failed, so this is not a single blip.
      </p>

      <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <tr>
          <td style="padding: 8px 0; color: #5b6472; width: 34%;">Endpoint</td>
          <td style="padding: 8px 0; font-family: ui-monospace, monospace; word-break: break-all;"><%= @service.http_method %> <%= @service.url %></td>
        </tr>
        <% if @error_message.present? %>
          <tr>
            <td style="padding: 8px 0; color: #5b6472; vertical-align: top;">Reason</td>
            <td style="padding: 8px 0; color: #e5484d;"><%= @error_message %></td>
          </tr>
        <% end %>
        <tr>
          <td style="padding: 8px 0; color: #5b6472;">Last checked</td>
          <td style="padding: 8px 0; font-family: ui-monospace, monospace;"><%= @service.last_checked_at&.strftime("%d %b %Y %H:%M:%S UTC") %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #5b6472;">Checked every</td>
          <td style="padding: 8px 0; font-family: ui-monospace, monospace;"><%= @service.check_interval_seconds %>s</td>
        </tr>
      </table>

      <% if @status_url.present? %>
        <p style="margin: 24px 0 0;">
          <a href="<%= @status_url %>" style="display: inline-block; background: #e8ecf2; color: #07090c; text-decoration: none; font-family: ui-monospace, monospace; font-size: 12px; letter-spacing: 0.11em; text-transform: uppercase; padding: 11px 18px; border-radius: 2px;">View status page</a>
        </p>
      <% end %>
    </div>

    <div style="padding: 14px 22px; border-top: 1px solid rgba(232,236,242,0.13); font-family: ui-monospace, monospace; font-size: 11px; color: #5b6472;">
      You'll get one more message when it recovers — not one per failed check.
    </div>
  </div>
</div>
