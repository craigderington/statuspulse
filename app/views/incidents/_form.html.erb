<%= form_with(model: incident, local: true, class: "form-card") do |f| %>
  <% if incident.errors.any? %>
    <div class="flash-message flash-alert" style="margin-bottom: 1.5rem;">
      <div>
        <strong><%= pluralize(incident.errors.count, "error") %> prevented saving this incident:</strong>
        <ul style="margin-top: 0.5rem; padding-left: 1.25rem;">
          <% incident.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <h2 style="margin-bottom: 1.5rem;"><%= incident.new_record? ? "Report New System Incident" : "Edit Incident Details" %></h2>

  <div class="form-group">
    <%= f.label :title, "Incident Title", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "e.g., High Error Rates on Payment API Gateway" %>
  </div>

  <div class="grid-2col">
    <div class="form-group">
      <%= f.label :severity, "Severity Level", class: "form-label" %>
      <%= f.select :severity, Incident::SEVERITIES.map { |s| [s.titleize, s] }, {}, class: "form-select" %>
    </div>

    <div class="form-group">
      <%= f.label :status, "Current Incident Stage", class: "form-label" %>
      <%= f.select :status, Incident::STATUSES.map { |s| [s.titleize, s] }, {}, class: "form-select" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :description, "Incident Description & Impact Summary", class: "form-label" %>
    <%= f.text_area :description, class: "form-textarea", placeholder: "Describe what is affected and current symptoms..." %>
  </div>

  <div class="form-group">
    <label class="form-label">Affected Services</label>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; background: rgba(9,13,22,0.6); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
      <% @available_services.each do |service| %>
        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-primary); font-size: 0.9rem;">
          <input type="checkbox" name="service_ids[]" value="<%= service.id %>" <%= 'checked' if incident.services.include?(service) %> style="accent-color: var(--accent-primary);">
          <span><%= service.name %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
    <%= link_to "Cancel", incidents_path, class: "btn btn-secondary" %>
    <%= f.submit incident.new_record? ? "Create Incident Log" : "Update Incident", class: "btn btn-primary" %>
  </div>
<% end %>
