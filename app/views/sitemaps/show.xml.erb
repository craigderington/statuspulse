<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc><%= root_url %></loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc><%= uptime_monitoring_for_agencies_url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc><%= multi_tenant_uptime_monitoring_url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc><%= client_uptime_reports_url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc><%= statuspage_alternative_url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% [ pricing_url, about_url, contact_url, privacy_url, terms_url ].each do |url| %>
  <url>
    <loc><%= url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <% end %>
<%# /signup is intentionally absent: robots.txt disallows it, and listing a
    disallowed URL in a sitemap is a contradiction Search Console reports as an
    error. The landing page is the entry point; it links to sign-up. %>
<% @organizations.each do |organization| %>
  <url>
    <loc><%= org_public_status_url(org_slug: organization.slug) %></loc>
    <changefreq>hourly</changefreq>
    <priority>0.8</priority>
  </url>
<% end %>
</urlset>
