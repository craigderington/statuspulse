<!DOCTYPE html>
<html lang="en">
  <head>
    <title>System Status — StatusPulse</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Live system uptime and incident status portal.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#6366f1">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="status-page-layout">
      <%= yield %>
      <footer class="footer" style="border:none; margin-top: 3rem;">
        <p>Powered by <strong style="color: var(--text-primary);">StatusPulse</strong> Uptime Monitor</p>
      </footer>
    </div>
  </body>
</html>
