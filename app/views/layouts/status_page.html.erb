<!DOCTYPE html>
<html lang="en">
  <head>
    <% status_name = @organization ? "#{@organization.name} Status" : "System Status" %>
    <% page_title = "#{status_name} — StatusPulse" %>
    <% page_description = "View live service health, 30-day uptime history, active incident updates, recent resolutions, and TLS certificate warnings for #{status_name}." %>
    <% canonical_url = request.original_url.split("?").first.sub("://www.", "://") %>
    <% social_image_url = "#{request.base_url}/og/statuspulse-card.png" %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Status pages are indexable by default — a client's customers should be
        able to find one when they suspect an outage. Tenants can opt out. %>
    <% if @organization && !@organization.status_page_indexable? %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>
    <link rel="canonical" href="<%= canonical_url %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="StatusPulse">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= social_image_url %>">
    <meta property="og:image:alt" content="StatusPulse tenant-isolated uptime monitoring">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= social_image_url %>">
    <meta name="twitter:image:alt" content="StatusPulse tenant-isolated uptime monitoring">
    <script type="application/ld+json">
<%= raw json_escape(JSON.pretty_generate({
  "@context" => "https://schema.org",
  "@type" => "WebPage",
  "name" => page_title,
  "url" => canonical_url,
  "description" => page_description
})) %>
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#6366f1">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="status-public-nav">
      <a href="<%= root_path %>" class="status-public-nav__brand" aria-label="StatusPulse home">
        <span class="brand-icon" style="width: 32px; height: 32px;" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg></span>
        StatusPulse
      </a>
      <nav class="status-public-nav__links" aria-label="Status page navigation">
        <a href="<%= root_path %>">Product</a>
        <a href="<%= signup_path %>">Create workspace</a>
      </nav>
    </header>
    <div class="status-page-layout">
      <%= yield %>
      <aside class="status-public-cta" aria-label="StatusPulse product">
        <strong>Need a status page for your services?</strong>
        <p>Monitor HTTP endpoints, keep an incident timeline, and publish live service health.</p>
        <a href="<%= uptime_monitoring_for_agencies_path %>">Explore StatusPulse monitoring</a>
      </aside>
      <footer class="footer" style="border:none; margin-top: 3rem;">
        <p>Powered by <strong style="color: var(--text-primary);">StatusPulse</strong> Uptime Monitor</p>
        <nav class="status-public-footer" aria-label="StatusPulse footer">
          <a href="<%= root_path %>">Home</a>
          <a href="<%= privacy_path %>">Privacy</a>
          <a href="<%= terms_path %>">Terms</a>
          <a href="<%= contact_path %>">Contact</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
