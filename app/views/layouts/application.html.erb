<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "StatusPulse — Uptime & Incident Command Center" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Real-time multi-tenant uptime monitoring, response latency analytics, and incident management platform.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Everything on this layout sits behind a sign-in. Keep it out of the
        index regardless of what robots.txt says — a disallow is a request, a
        noindex is a directive. %>
    <meta name="robots" content="noindex, nofollow">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <meta name="theme-color" content="#6366f1">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="app-header">
      <div class="header-container">
        <a href="<%= root_path %>" class="brand">
          <div class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <div>
            <span class="brand-name">StatusPulse</span>
            <% if current_organization %>
              <div style="font-size: 0.7rem; color: var(--accent-cyan); line-height: 1;"><%= current_organization.name %></div>
            <% end %>
          </div>
        </a>

        <nav class="nav-links">
          <% if Current.user.present? %>
            <a href="<%= dashboard_path %>" class="nav-link <%= 'active' if controller_name == 'dashboard' %>">Dashboard</a>
            <a href="<%= services_path %>" class="nav-link <%= 'active' if controller_name == 'services' %>">Services</a>
            <a href="<%= incidents_path %>" class="nav-link <%= 'active' if controller_name == 'incidents' %>">Incidents</a>
            <a href="<%= reports_path %>" class="nav-link <%= 'active' if controller_name == 'reports' %>">Reports</a>
            
            <a href="<%= org_public_status_path(org_slug: current_organization.slug) %>" target="_blank" class="btn btn-secondary btn-sm">
              <span>Public Page</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>

            <%# Account actions hang off the person, not the workspace nav:
                Security is per-user, while Settings is org-scoped and admin-only. %>
            <div class="account" data-controller="menu">
              <button type="button" class="account__trigger"
                      data-menu-target="trigger" data-action="menu#toggle"
                      aria-haspopup="true" aria-expanded="false">
                <span class="account__name"><%= Current.user.name %></span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>

              <div class="account__menu" data-menu-target="menu" data-open="false" role="menu">
                <div class="account__who">
                  <span class="account__email"><%= Current.user.email %></span>
                  <span class="account__role"><%= Current.user.role.titleize %></span>
                </div>
                <% if Current.user.admin? %>
                  <a href="<%= edit_organization_path %>" class="account__item" role="menuitem">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    Workspace settings
                  </a>
                <% end %>
                <a href="<%= security_path %>" class="account__item" role="menuitem">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  Security
                </a>
                <%= button_to logout_path, method: :delete, class: "account__item account__item--button", role: "menuitem" do %>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                  Sign out
                <% end %>
              </div>
            </div>
          <% else %>
            <a href="<%= public_status_path %>" target="_blank" class="nav-link">Public Page</a>
            <a href="<%= login_path %>" class="nav-link">Sign In</a>
            <a href="<%= signup_path %>" class="btn btn-primary btn-sm">Get Started</a>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <div class="flash-message flash-notice">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <%= notice %>
        </div>
      <% end %>

      <% if alert %>
        <div class="flash-message flash-alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer">
      <div class="container" style="margin: 0 auto;">
        <p>StatusPulse Multi-Tenant Uptime Platform & Weekly Digest Mailer — Ruby on Rails 8</p>
      </div>
    </footer>
  </body>
</html>
