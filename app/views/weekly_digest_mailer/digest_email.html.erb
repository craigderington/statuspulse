<!DOCTYPE html>
<html>
  <head>
    <meta style="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #090d16; color: #f3f4f6; margin: 0; padding: 20px; }
      .email-container { max-width: 600px; margin: 0 auto; background-color: #121826; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 30px; }
      .header { border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 20px; margin-bottom: 20px; text-align: center; }
      .brand { font-size: 24px; font-weight: bold; color: #6366f1; }
      .stat-grid { display: table; width: 100%; margin: 20px 0; }
      .stat-box { display: table-cell; width: 33%; background: rgba(255,255,255,0.03); padding: 15px; border-radius: 8px; text-align: center; }
      .stat-num { font-size: 22px; font-weight: bold; color: #10b981; }
      .service-row { border-bottom: 1px solid rgba(255,255,255,0.05); padding: 12px 0; }
      .badge { display: inline-block; padding: 3px 8px; border-radius: 12px; font-size: 12px; font-weight: bold; }
      .badge-operational { background: rgba(16,185,129,0.2); color: #34d399; }
      .badge-degraded { background: rgba(245,158,11,0.2); color: #fbbf24; }
      .badge-outage { background: rgba(239,68,68,0.2); color: #f87171; }
    </style>
  </head>
  <body>
    <div class="email-container">
      <div class="header">
        <div class="brand">StatusPulse</div>
        <h2 style="margin: 10px 0 0 0; color: #ffffff;">Weekly Infrastructure Digest</h2>
        <p style="color: #9ca3af; margin-top: 5px;"><%= @organization.name %></p>
      </div>

      <p>Here is your weekly uptime report for the past 7 days:</p>

      <div class="stat-grid">
        <div class="stat-box">
          <div style="font-size: 12px; color: #9ca3af; text-transform: uppercase;">Average Uptime</div>
          <div class="stat-num"><%= @avg_uptime %>%</div>
        </div>
        <div class="stat-box">
          <div style="font-size: 12px; color: #9ca3af; text-transform: uppercase;">Avg Response</div>
          <div class="stat-num" style="color: #06b6d4;"><%= @avg_latency %> ms</div>
        </div>
        <div class="stat-box">
          <div style="font-size: 12px; color: #9ca3af; text-transform: uppercase;">7-Day Incidents</div>
          <div class="stat-num" style="color: #f3f4f6;"><%= @incidents_count %></div>
        </div>
      </div>

      <h3 style="color: #ffffff; margin-top: 25px;">Services Uptime Status</h3>

      <% @services.each do |service| %>
        <div class="service-row">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <strong style="color: #ffffff;"><%= service.name %></strong>
              <div style="font-size: 12px; color: #9ca3af;"><%= service.url %></div>
            </div>
            <span class="badge badge-<%= service.status %>"><%= service.status.titleize %></span>
          </div>
        </div>
      <% end %>

      <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 12px; color: #6b7280;">
        Sent automatically by StatusPulse Monitoring Platform for <%= @organization.name %>.
      </div>
    </div>
  </body>
</html>
