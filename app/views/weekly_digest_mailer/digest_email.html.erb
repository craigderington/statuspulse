<%
  # Inline styles only: Gmail and Outlook.com strip <style> blocks in forwarded
  # and some mobile views, and Outlook's Word engine ignores rgba(), display:table
  # and flexbox. Every colour below is a solid hex already blended over its
  # backdrop, layout is table-based, and backgrounds carry a bgcolor attribute
  # alongside the CSS because Outlook honours the attribute more reliably.
  badge_palette = Hash.new({ bg: "#1e2431", fg: "#9ca3af" })
  badge_palette["operational"] = { bg: "#123838", fg: "#34d399" }
  badge_palette["degraded"]    = { bg: "#3f3321", fg: "#fbbf24" }
  badge_palette["outage"]      = { bg: "#3e212c", fg: "#f87171" }
  badge_palette["maintenance"] = { bg: "#1a2d50", fg: "#93c5fd" }

  font_stack = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
  muted      = "#9ca3af"
  hairline   = "#2a2f3c"
%>
<% content_for :email_bg, "#090d16" %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#090d16" style="background-color: #090d16; margin: 0; padding: 0;">
  <tr>
    <td align="center" style="padding: 20px 10px;">

      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" bgcolor="#121826" style="max-width: 600px; width: 100%; background-color: #121826; border: 1px solid <%= hairline %>; border-radius: 12px;">
        <tr>
          <td style="padding: 30px;">

            <!-- header -->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td align="center" style="padding-bottom: 20px; border-bottom: 1px solid <%= hairline %>;">
                  <div style="font-family: <%= font_stack %>; font-size: 24px; font-weight: bold; color: #818cf8;">StatusPulse</div>
                  <h2 style="font-family: <%= font_stack %>; margin: 10px 0 0 0; font-size: 20px; color: #ffffff;">Weekly Infrastructure Digest</h2>
                  <p style="font-family: <%= font_stack %>; font-size: 14px; color: <%= muted %>; margin: 5px 0 0 0;"><%= @organization.name %></p>
                </td>
              </tr>
            </table>

            <p style="font-family: <%= font_stack %>; font-size: 14px; color: #f3f4f6; margin: 20px 0;">Here is your weekly uptime report for the past 7 days:</p>

            <!-- stat grid -->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 20px 0;">
              <tr>
                <td width="32%" align="center" valign="top" bgcolor="#1b2333" style="background-color: #1b2333; border-radius: 8px; padding: 15px;">
                  <div style="font-family: <%= font_stack %>; font-size: 12px; color: <%= muted %>; text-transform: uppercase;">Average Uptime</div>
                  <div style="font-family: <%= font_stack %>; font-size: 22px; font-weight: bold; color: #6ee7b7; padding-top: 4px;"><%= @avg_uptime %>%</div>
                </td>
                <td width="2%">&nbsp;</td>
                <td width="32%" align="center" valign="top" bgcolor="#1b2333" style="background-color: #1b2333; border-radius: 8px; padding: 15px;">
                  <div style="font-family: <%= font_stack %>; font-size: 12px; color: <%= muted %>; text-transform: uppercase;">Avg Response</div>
                  <div style="font-family: <%= font_stack %>; font-size: 22px; font-weight: bold; color: #67e8f9; padding-top: 4px;"><%= @avg_latency %> ms</div>
                </td>
                <td width="2%">&nbsp;</td>
                <td width="32%" align="center" valign="top" bgcolor="#1b2333" style="background-color: #1b2333; border-radius: 8px; padding: 15px;">
                  <div style="font-family: <%= font_stack %>; font-size: 12px; color: <%= muted %>; text-transform: uppercase;">7-Day Incidents</div>
                  <div style="font-family: <%= font_stack %>; font-size: 22px; font-weight: bold; color: #f3f4f6; padding-top: 4px;"><%= @incidents_count %></div>
                </td>
              </tr>
            </table>

            <h3 style="font-family: <%= font_stack %>; font-size: 16px; color: #ffffff; margin: 25px 0 0 0;">Services Uptime Status</h3>

            <!-- service rows -->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <% @services.each do |service| %>
                <% palette = badge_palette[service.status] %>
                <tr>
                  <td valign="middle" style="padding: 12px 0; border-bottom: 1px solid #1e2431;">
                    <strong style="font-family: <%= font_stack %>; font-size: 14px; color: #ffffff;"><%= service.name %></strong>
                    <div style="font-family: <%= font_stack %>; font-size: 12px; color: <%= muted %>; padding-top: 2px;"><%= service.url %></div>
                  </td>
                  <td valign="middle" align="right" style="padding: 12px 0; border-bottom: 1px solid #1e2431; white-space: nowrap;">
                    <span style="font-family: <%= font_stack %>; display: inline-block; padding: 3px 8px; border-radius: 12px; font-size: 12px; font-weight: bold; background-color: <%= palette[:bg] %>; color: <%= palette[:fg] %>;"><%= service.status.titleize %></span>
                  </td>
                </tr>
              <% end %>
            </table>

            <!-- footer -->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top: 30px;">
              <tr>
                <td align="center" style="padding-top: 20px; border-top: 1px solid <%= hairline %>;">
                  <div style="font-family: <%= font_stack %>; font-size: 12px; color: <%= muted %>;">
                    Sent automatically by StatusPulse Monitoring Platform for <%= @organization.name %>.
                  </div>
                </td>
              </tr>
            </table>

          </td>
        </tr>
      </table>

    </td>
  </tr>
</table>
