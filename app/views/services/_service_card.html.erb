<div id="service_<%= service.id %>" class="service-card">
  <div class="service-main">
    <div>
      <div class="service-meta">
        <a href="<%= service_path(service) %>" class="service-name"><%= service.name %></a>
        <span class="http-method-badge"><%= service.http_method %></span>
        <% if service.paused? %>
          <span class="paused-badge" title="Automatic checks suspended">Paused</span>
        <% end %>
        <% if service.headers.present? %>
          <span style="font-size: 0.75rem; color: var(--accent-cyan); background: rgba(6,182,212,0.1); padding: 2px 6px; border-radius: 4px;" title="Custom Headers Configured">Headers</span>
        <% end %>
        <% if service.request_body.present? %>
          <span style="font-size: 0.75rem; color: var(--accent-primary); background: rgba(99,102,241,0.1); padding: 2px 6px; border-radius: 4px;" title="Custom Request Payload Configured">Body</span>
        <% end %>
      </div>
      <div class="service-url"><%= service.url %></div>
      <% if service.description.present? %>
        <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;"><%= service.description %></div>
      <% end %>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <div style="text-align: right;">
        <div class="service-status-badge badge-<%= service.status %>">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: currentColor;"></span>
          <%= service.status.titleize %>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.3rem;">
          <% if service.last_response_time_ms.present? %>
            <strong style="color: var(--text-primary);"><%= service.last_response_time_ms %> ms</strong> latency
          <% else %>
            Not checked yet
          <% end %>
        </div>
        <div class="service-countdown"
             data-controller="countdown"
             data-countdown-seconds-value="<%= service.seconds_until_next_check %>"
             data-countdown-checked-value="<%= service.last_checked_at.present? %>"
             data-countdown-paused-value="<%= service.paused? %>">
        </div>
      </div>

      <%= button_to check_now_service_path(service), method: :post, class: "btn btn-secondary btn-sm", title: "Trigger HTTP Ping check now" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        <span>Ping</span>
      <% end %>
    </div>
  </div>

  <% bar_count = Service::TIMELINE_BAR_COUNT %>
  <div class="timeline-container">
    <div class="timeline-bars">
      <% service.history_bars(bar_count).each do |bar| %>
        <% if bar[:success].nil? %>
          <div class="timeline-bar bar-empty" title="No check data"></div>
        <% elsif bar[:success] %>
          <div class="timeline-bar <%= bar[:latency].to_i > 2500 ? 'bar-degraded' : 'bar-success' %>" 
               title="HTTP <%= bar[:code] %> — <%= bar[:latency] %>ms (<%= bar[:date]&.strftime('%b %d, %H:%M') %>)"></div>
        <% else %>
          <div class="timeline-bar bar-failed" 
               title="Failed: HTTP <%= bar[:code] %> (<%= bar[:date]&.strftime('%b %d, %H:%M') %>)"></div>
        <% end %>
      <% end %>
    </div>
    <div class="timeline-labels">
      <span><%= bar_count %> checks ago</span>
      <span><%= number_with_precision(service.uptime_percentage, precision: 2) %>% 30-day uptime</span>
      <span>Latest</span>
    </div>
  </div>
</div>
