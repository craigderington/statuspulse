<div style="margin-bottom: 2rem;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
        <span class="http-method-badge" style="font-size: 0.9rem;"><%= @service.http_method %></span>
        <h1 style="font-size: 1.85rem; font-weight: 700;"><%= @service.name %></h1>
        <div class="service-status-badge badge-<%= @service.status %>">
          <%= @service.status.titleize %>
        </div>
      </div>
      <div class="service-url" style="font-size: 1rem;"><%= @service.url %></div>
      <% if @service.description.present? %>
        <p style="color: var(--text-secondary); margin-top: 0.5rem;"><%= @service.description %></p>
      <% end %>
    </div>

    <div style="display: flex; gap: 0.75rem;">
      <%= button_to check_now_service_path(@service), method: :post, class: "btn btn-primary" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        <span>Ping Endpoint Now</span>
      <% end %>
      <%= link_to "Edit Config", edit_service_path(@service), class: "btn btn-secondary" %>
      <%= button_to "Delete", service_path(@service), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this monitored endpoint?" }, class: "btn btn-danger" %>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-label">30-Day Uptime</div>
      <div class="stat-value" style="color: var(--color-operational);"><%= @service.uptime_percentage %>%</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Avg Response Latency</div>
      <div class="stat-value" style="color: var(--accent-cyan);"><%= @service.average_response_time_ms %> ms</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Expected HTTP Code</div>
      <div class="stat-value" style="font-family: 'Fira Code', monospace;"><%= @service.expected_status_code %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Check Interval</div>
      <div class="stat-value"><%= @service.check_interval_seconds %>s</div>
    </div>
  </div>
</div>

<div class="grid-2col" style="margin-bottom: 2.5rem;">
  <div class="stat-card">
    <h3 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--accent-cyan);">HTTP Headers Configuration</h3>
    <% if @service.headers.present? %>
      <pre style="background: rgba(9, 13, 22, 0.8); border: 1px solid var(--border-color); padding: 1rem; border-radius: 8px; font-family: 'Fira Code', monospace; font-size: 0.85rem; overflow-x: auto; color: #a7f3d0;"><%= @service.headers %></pre>
    <% else %>
      <p style="color: var(--text-muted); font-size: 0.9rem;">No custom HTTP headers configured (Uses default User-Agent).</p>
    <% end %>
  </div>

  <div class="stat-card">
    <h3 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--accent-primary);">Request Payload & Body Matching</h3>
    <% if @service.request_body.present? %>
      <div style="margin-bottom: 0.75rem;">
        <span class="stat-label" style="font-size: 0.75rem;">Payload:</span>
        <pre style="background: rgba(9, 13, 22, 0.8); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: 8px; font-family: 'Fira Code', monospace; font-size: 0.85rem; overflow-x: auto; color: #cbd5e1;"><%= @service.request_body %></pre>
      </div>
    <% end %>

    <% if @service.expected_body_match.present? %>
      <div>
        <span class="stat-label" style="font-size: 0.75rem;">Expected Body Substring:</span>
        <code style="display: block; background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.3); padding: 0.5rem; border-radius: 6px; color: #a5b4fc; font-family: 'Fira Code', monospace; font-size: 0.85rem;"><%= @service.expected_body_match %></code>
      </div>
    <% end %>

    <% if @service.request_body.blank? && @service.expected_body_match.blank? %>
      <p style="color: var(--text-muted); font-size: 0.9rem;">No payload or body matching rules configured.</p>
    <% end %>
  </div>
</div>

<div class="section-header">
  <h2 class="section-title">Recent Telemetry Check Logs</h2>
</div>

<div class="stat-card" style="padding: 0; overflow: hidden;">
  <table style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border-color); background: rgba(255,255,255,0.03); color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">
        <th style="padding: 1rem;">Timestamp</th>
        <th style="padding: 1rem;">Status Code</th>
        <th style="padding: 1rem;">Response Time</th>
        <th style="padding: 1rem;">Result</th>
        <th style="padding: 1rem;">Details / Error</th>
      </tr>
    </thead>
    <tbody>
      <% if @check_logs.empty? %>
        <tr>
          <td colspan="5" style="padding: 2rem; text-align: center; color: var(--text-muted);">No check logs recorded yet. Click "Ping Endpoint Now" to run a check.</td>
        </tr>
      <% else %>
        <% @check_logs.each do |log| %>
          <tr style="border-bottom: 1px solid var(--border-color); font-size: 0.9rem;">
            <td style="padding: 0.85rem 1rem; color: var(--text-secondary);"><%= log.created_at.strftime("%b %d, %Y %H:%M:%S") %></td>
            <td style="padding: 0.85rem 1rem; font-family: 'Fira Code', monospace; font-weight: 600;">
              <span style="color: <%= log.success ? 'var(--color-operational)' : 'var(--color-outage)' %>;">
                <%= log.status_code.zero? ? 'TIMEOUT' : "HTTP #{log.status_code}" %>
              </span>
            </td>
            <td style="padding: 0.85rem 1rem; font-family: 'Fira Code', monospace;"><%= log.response_time_ms %> ms</td>
            <td style="padding: 0.85rem 1rem;">
              <% if log.success %>
                <span class="service-status-badge badge-operational" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">PASS</span>
              <% else %>
                <span class="service-status-badge badge-outage" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">FAIL</span>
              <% end %>
            </td>
            <td style="padding: 0.85rem 1rem; color: var(--text-secondary);">
              <%= log.error_message.presence || "OK — Response matched expectations" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
