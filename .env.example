# ==============================================================================
# StatusPulse Production Environment Variables Configuration Template
# Copy this file to '.env' on your server and fill in the required secret values.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Rails Application Environment & Secrets
# ------------------------------------------------------------------------------
# Application environment (always 'production' for live deployments)
RAILS_ENV=production

# Domain name for the application instance
DOMAIN_NAME=statuspulse.org

# Secret key base used for signing session cookies and cryptographic tokens.
# Generate a new secure secret using: bin/rails secret (or rake secret)
SECRET_KEY_BASE=your_generated_secret_key_base_here

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
# Hostname of the database container service in docker-compose.prod.yml
DATABASE_HOST=db

# PostgreSQL user name. Must be a superuser (or hold CREATEDB): Rails 8 uses four
# databases and db:prepare creates the _cache, _queue and _cable ones on first boot.
DATABASE_USERNAME=postgres

# Primary database name. The three Solid adapter databases derive from it
# (statuspulse_production_cache / _queue / _cable).
DATABASE_NAME=statuspulse_production

# Master PostgreSQL password. This is the only DB password you set by hand —
# docker-compose.prod.yml derives DATABASE_PASSWORD and STATUSPULSE_DATABASE_PASSWORD
# from it, so all four databases stay in sync automatically.
# Generate a strong password (e.g., using `openssl rand -hex 32`)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# Mailgun HTTP API Email Delivery
# ------------------------------------------------------------------------------
# Mail is sent through the Mailgun HTTP API rather than SMTP: AWS restricts
# outbound SMTP on Lightsail/EC2 by default, while this is plain HTTPS on 443.
# Implementation lives in lib/mailgun_api_delivery.rb.

# Private API key from Mailgun → Settings → API Keys. Starts with "key-".
# This is a sending credential — treat it like a password.
MAILGUN_API_KEY=your_mailgun_private_api_key_here

# The verified sending domain in your Mailgun dashboard. Use the exact value
# shown there: if you set up a subdomain sender it will be mg.statuspulse.org.
MAILGUN_DOMAIN=statuspulse.org

# Region endpoint. Leave as-is for a US account; EU accounts must use
# https://api.eu.mailgun.net or every send returns 401.
MAILGUN_API_BASE=https://api.mailgun.net

# Envelope sender. MUST be on the same domain as MAILGUN_DOMAIN above — if your
# verified sender is mg.statuspulse.org, a From: of @statuspulse.org fails
# DKIM/SPF alignment and lands in spam or is rejected.
#
# A display name is supported and strongly recommended — inboxes show it instead
# of the bare address. Quote the whole value so the angle brackets survive.
MAIL_FROM="StatusPulse <noreply@mg.statuspulse.org>"

# Optional: separate sender for the weekly digest. Falls back to MAIL_FROM.
MAIL_FROM_DIGEST="StatusPulse Reports <reports@mg.statuspulse.org>"
